# --- secrets / local data: NEVER commit ---
.env
.env.*
!.env.example
*.key
*.pem
config.local.*
data/
*.sqlite3
*.db
__pycache__/
*.pyc
.venv/
# Build metadata, regenerated by every editable install. Committing it made
# `git describe` report -dirty on every deployment host the moment the
# package was installed, so a correctly deployed release looked modified and
# the real signal ("someone edited production") was lost in the noise.
*.egg-info/
node_modules/
dist/
.pytest_cache/
