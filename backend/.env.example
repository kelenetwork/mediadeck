# mediadeck backend configuration — copy to .env and fill in.
# NO real values belong in the repository.
#
# Only bootstrap/process-level settings live here. Everything an operator is
# expected to change — Emby connection, streaming nodes, dispatch policy — is
# configured from the panel UI ("系统设置") and stored in the data directory,
# so it can be changed without shell access or a restart.

# Set to 1 to run entirely on mock adapters (no credentials needed)
MEDIADECK_MOCK=1

# Panel auth (single admin for now)
MEDIADECK_ADMIN_USER=admin
MEDIADECK_ADMIN_PASSWORD=change-me

# Where operator settings are persisted (settings.json, mode 600)
MEDIADECK_DATA_DIR=data

# --- bootstrap only -------------------------------------------------------
# Read once on first run to seed the settings store, so pre-existing
# deployments keep working after upgrading. Later edits happen in the UI.
EMBY_URL=http://127.0.0.1:8096
EMBY_API_KEY=

# Streaming nodes (JSON list; each node exposes a /load probe).
# capacity = max concurrent streams the node can serve.
# Example: [{"name":"node-a","base_url":"https://node-a.example.com","probe_url":"http://10.0.0.2:9800/load","capacity":150}]
STREAM_NODES=[]

# Sanitized JSON snapshots written by host-local collectors (no real paths)
TASKS_SNAPSHOT_PATH=
