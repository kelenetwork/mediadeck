# mediadeck backend configuration — copy to .env and fill in.
# NO real values belong in the repository.

# Set to 1 to run entirely on mock adapters (no credentials needed)
MEDIADECK_MOCK=1

# Panel auth (single admin for now)
MEDIADECK_ADMIN_USER=admin
MEDIADECK_ADMIN_PASSWORD=change-me

# Emby
EMBY_URL=http://127.0.0.1:8096
EMBY_API_KEY=

# MoviePilot
MP_URL=http://127.0.0.1:3000
MP_USERNAME=
MP_PASSWORD=

# Streaming nodes (JSON list; each node exposes /load probe)
# Example: [{"name":"node-a","base_url":"https://node-a.example.com","probe_url":"http://10.0.0.2:9800/load","weight":2}]
STREAM_NODES=[]
